@page "/accounts"
@inject AppDbContext Db

<h3>Accounts</h3>

<button>Add Test Account</button>

@code {
    List<Account> accounts = new List<Account>();

    protected override async Task OnInitializedAsync()
    {
        // Get current existing accounts and if none exist, initialize an empty list
        accounts = await Db.Accounts.ToListAsync() ?? new List<Account>();
    }
}
