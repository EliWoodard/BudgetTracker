@inherits LayoutComponentBase

<MudLayout>
    <AppBar />
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Docked" Elevation="0">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pa-0">
        @Body
    </MudMainContent>
</MudLayout>

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />