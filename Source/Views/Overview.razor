@page "/"

<PageTitle>Overview</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <!--Overview Header(4 elements)-->
    <MudGrid>
        <!--Monthly Income-->
        <MudItem xs="12" sm="12" md="3">
            <MudPaper Class="pa-4 position-relative" Style="height: 180px; overflow-x: hidden;">
                <MudStack Class="h-100">
                    <MudText Typo="Typo.body1">
                        Monthly Income
                    </MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: bold">
                        $5,420
                    </MudText>
                    <MudText Typo="Typo.subtitle2" Color="Color.Success">
                        +4.8% vs last month
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <!--Total Earned-->
        <MudItem xs="12" sm="12" md="3">
            <MudPaper Class="pa-4 position-relative" Style="height: 180px; overflow-x: hidden;">
                <MudStack Class="h-100">
                    <MudText Typo="Typo.body1">
                        Total Earned
                    </MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: bold">
                        $2,164.32
                    </MudText>
                    <MudText Typo="Typo.subtitle2" Color="Color.Success">
                        +2.1% vs last month
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <!--Total Spending-->
        <MudItem xs="12" sm="12" md="3">
            <MudPaper Class="pa-4 position-relative" Style="height: 180px; overflow-x: hidden;">
                <MudStack Class="h-100">
                    <MudText Typo="Typo.body1">
                        Total Spent
                    </MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: bold">
                        $2,846.32
                    </MudText>
                    <MudText Typo="Typo.subtitle2" Color="Color.Success">
                        +2.1% vs last month
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <!--Upcoming Bills-->
        <MudItem xs="12" sm="12" md="3">
            <MudPaper Class="pa-4 position-relative" Style="height: 180px; overflow-x: hidden;">
                <MudStack Class="h-100">
                    <MudText Typo="Typo.body1">
                        Upcoming Bills
                    </MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: bold">
                        $1,754.32
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <!--Overview Graphs(2 elements)-->
    <MudGrid>
        <!--Cash Flow-->
        <MudItem xs="12" sm="12" md="6">
            <MudPaper></MudPaper>
        </MudItem>
        <!--Spending by Category-->
        <MudItem xs="12" sm="12" md="6">
            <MudPaper></MudPaper>
        </MudItem>
    </MudGrid>
    <!--Overview Charts(2 elements)-->
    <MudGrid>
        <!--Recent Transactions-->
        <MudItem xs="12" sm="12" md="6">
            <MudPaper></MudPaper>
        </MudItem>
        <!--Budget Progress-->
        <MudItem xs="12" sm="12" md="6">
            <MudPaper></MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

