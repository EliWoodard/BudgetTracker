@page "/overview"

<PageTitle>Overview</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <!--Overview Header(4 elements)-->
    <MudGrid>
        <!--Monthly Income-->
        <MudItem xs="12" sm="12" md="3">
            <MudPaper></MudPaper>
        </MudItem>
        <!--Total Spending-->
        <MudItem xs="12" sm="12" md="3">
            <MudPaper></MudPaper>
        </MudItem>
        <!--Available to Budget-->
        <MudItem xs="12" sm="12" md="3">
            <MudPaper></MudPaper>
        </MudItem>
        <!--Savings Rate-->
        <MudItem xs="12" sm="12" md="3">
            <MudPaper></MudPaper>
        </MudItem>
    </MudGrid>
    <!--Overview Graphs(2 elements)-->
    <MudGrid>
        <!--Cash Flow-->
        <MudItem xs="12" sm="12" md="6">
            <MudPaper></MudPaper>
        </MudItem>
        <!--Spending by Category-->
        <MudItem xs="12" sm="12" md="6">
            <MudPaper></MudPaper>
        </MudItem>
    </MudGrid>
    <!--Overview Charts(2 elements)-->
    <MudGrid>
        <!--Recent Transactions-->
        <MudItem xs="12" sm="12" md="6">
            <MudPaper></MudPaper>
        </MudItem>
        <!--Budget Progress-->
        <MudItem xs="12" sm="12" md="6">
            <MudPaper></MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

