<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-4 py-2" Style="width: 100%;">
    @* Greeting *@
    <MudText Typo="Typo.h6">
        Good morning, User
    </MudText>
    @* Header Actions *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit" Size="Size.Medium"  />
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Size="Size.Medium" />
        @* User Profile *@
        <MudAvatar Color="Color.Secondary" Size="Size.Medium">
            <MudIcon Icon="@Icons.Material.Filled.Person" />
        </MudAvatar>
    </MudStack>
</MudStack>

